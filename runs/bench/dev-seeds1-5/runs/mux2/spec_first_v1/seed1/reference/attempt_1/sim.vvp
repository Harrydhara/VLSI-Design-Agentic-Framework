#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a15fadc60f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a15fadc6280 .scope module, "ref_tb" "ref_tb" 3 5;
 .timescale -9 -12;
v0x5a15fade4d10_0 .var "a", 7 0;
v0x5a15fade4df0_0 .var "b", 7 0;
v0x5a15fade4ec0_0 .var "expected", 7 0;
v0x5a15fade4f90_0 .var/i "i", 31 0;
v0x5a15fade5070_0 .var/i "j", 31 0;
v0x5a15fade51a0_0 .var/i "passed", 31 0;
v0x5a15fade5280_0 .var/i "s", 31 0;
v0x5a15fade5360_0 .var/i "seed", 31 0;
v0x5a15fade5440_0 .var "sel", 0 0;
v0x5a15fade54e0_0 .var/i "shown", 31 0;
v0x5a15fade55a0_0 .var/i "total", 31 0;
v0x5a15fade5680_0 .net "y", 7 0, L_0x5a15fade5770;  1 drivers
S_0x5a15fad8c490 .scope task, "check" "check" 3 14, 3 14 0, S_0x5a15fadc6280;
 .timescale -9 -12;
TD_ref_tb.check ;
    %delay 1000, 0;
    %load/vec4 v0x5a15fade5440_0;
    %flag_set/vec4 8;
    %jmp/0 T_0.0, 8;
    %load/vec4 v0x5a15fade4df0_0;
    %jmp/1 T_0.1, 8;
T_0.0 ; End of true expr.
    %load/vec4 v0x5a15fade4d10_0;
    %jmp/0 T_0.1, 8;
 ; End of false expr.
    %blend;
T_0.1;
    %store/vec4 v0x5a15fade4ec0_0, 0, 8;
    %load/vec4 v0x5a15fade55a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade55a0_0, 0, 32;
    %load/vec4 v0x5a15fade5680_0;
    %load/vec4 v0x5a15fade4ec0_0;
    %cmp/e;
    %jmp/0xz  T_0.2, 6;
    %load/vec4 v0x5a15fade51a0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade51a0_0, 0, 32;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x5a15fade54e0_0;
    %cmpi/s 5, 0, 32;
    %jmp/0xz  T_0.4, 5;
    %load/vec4 v0x5a15fade54e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade54e0_0, 0, 32;
    %vpi_call/w 3 22 "$display", "MISMATCH a=%h b=%h sel=%b: expected y=%h, got y=%h", v0x5a15fade4d10_0, v0x5a15fade4df0_0, v0x5a15fade5440_0, v0x5a15fade4ec0_0, v0x5a15fade5680_0 {0 0 0};
T_0.4 ;
T_0.3 ;
    %end;
S_0x5a15fad8c670 .scope module, "dut" "mux2" 3 12, 4 1 0, S_0x5a15fadc6280;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 8 "y";
v0x5a15fadc6410_0 .net "a", 7 0, v0x5a15fade4d10_0;  1 drivers
v0x5a15fade4a30_0 .net "b", 7 0, v0x5a15fade4df0_0;  1 drivers
v0x5a15fade4b10_0 .net "sel", 0 0, v0x5a15fade5440_0;  1 drivers
v0x5a15fade4bb0_0 .net "y", 7 0, L_0x5a15fade5770;  alias, 1 drivers
L_0x5a15fade5770 .functor MUXZ 8, v0x5a15fade4d10_0, v0x5a15fade4df0_0, v0x5a15fade5440_0, C4<>;
    .scope S_0x5a15fadc6280;
T_1 ;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x5a15fade5360_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade51a0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade55a0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade54e0_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5a15fadc6280;
T_2 ;
    %vpi_func 3 28 "$test$plusargs" 32, "vcd" {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %vpi_call/w 3 29 "$dumpfile", "reference.vcd" {0 0 0};
    %vpi_call/w 3 30 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a15fadc6280 {0 0 0};
T_2.0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade5280_0, 0, 32;
T_2.2 ;
    %load/vec4 v0x5a15fade5280_0;
    %cmpi/s 2, 0, 32;
    %jmp/0xz T_2.3, 5;
    %load/vec4 v0x5a15fade5280_0;
    %parti/s 1, 0, 2;
    %store/vec4 v0x5a15fade5440_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %pushi/vec4 170, 0, 8;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %pushi/vec4 85, 0, 8;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %pushi/vec4 85, 0, 8;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %pushi/vec4 170, 0, 8;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade5070_0, 0, 32;
T_2.4 ;
    %load/vec4 v0x5a15fade5070_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_2.5, 5;
    %pushi/vec4 1, 0, 8;
    %load/vec4 v0x5a15fade5070_0;
    %ix/vec4 4;
    %shiftl 4;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %pushi/vec4 1, 0, 8;
    %load/vec4 v0x5a15fade5070_0;
    %ix/vec4 4;
    %shiftl 4;
    %inv;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %load/vec4 v0x5a15fade5070_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade5070_0, 0, 32;
    %jmp T_2.4;
T_2.5 ;
    %load/vec4 v0x5a15fade5280_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade5280_0, 0, 32;
    %jmp T_2.2;
T_2.3 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a15fade4f90_0, 0, 32;
T_2.6 ;
    %load/vec4 v0x5a15fade4f90_0;
    %cmpi/s 500, 0, 32;
    %jmp/0xz T_2.7, 5;
    %vpi_func 3 45 "$random" 32, v0x5a15fade5360_0 {0 0 0};
    %pad/s 8;
    %store/vec4 v0x5a15fade4d10_0, 0, 8;
    %vpi_func 3 46 "$random" 32, v0x5a15fade5360_0 {0 0 0};
    %pad/s 8;
    %store/vec4 v0x5a15fade4df0_0, 0, 8;
    %vpi_func 3 47 "$random" 32, v0x5a15fade5360_0 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x5a15fade5440_0, 0, 1;
    %fork TD_ref_tb.check, S_0x5a15fad8c490;
    %join;
    %load/vec4 v0x5a15fade4f90_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5a15fade4f90_0, 0, 32;
    %jmp T_2.6;
T_2.7 ;
    %vpi_call/w 3 50 "$display", "RESULT dae8d5d079e77343: %0d/%0d passed", v0x5a15fade51a0_0, v0x5a15fade55a0_0 {0 0 0};
    %vpi_call/w 3 51 "$finish" {0 0 0};
    %end;
    .thread T_2;
