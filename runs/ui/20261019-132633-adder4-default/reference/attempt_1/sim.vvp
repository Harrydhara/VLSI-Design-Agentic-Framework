    %load/vec4 v0x5ecd1db2f3a0_0;
    %load/vec4 v0x5ecd1db2f7c0_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v0x5ecd1db2f470_0;
    %cmp/e;
    %jmp/0xz  T_1.4, 6;
    %load/vec4 v0x5ecd1db2f600_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5ecd1db2f600_0, 0, 32;
    %jmp T_1.5;
T_1.4 ;
