    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5ecd1db2f880_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5ecd1db2f6e0_0, 0, 32;
    %end;
    .thread T_0, $init;
    .scope S_0x5ecd1db14750;
T_1 ;
    %vpi_func 3 15 "$test$plusargs" 32, "vcd" {0 0 0};
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_1.0, 4;
