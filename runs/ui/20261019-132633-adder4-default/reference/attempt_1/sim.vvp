v0x5ecd1db2f880_0 .var/i "total", 31 0;
S_0x5ecd1dada490 .scope module, "dut" "adder4" 3 12, 4 1 0, S_0x5ecd1db14750;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /INPUT 1 "cin";
    .port_info 3 /OUTPUT 4 "sum";
    .port_info 4 /OUTPUT 1 "cout";
