    %vpi_call/w 3 27 "$display", "MISMATCH a=%0d b=%0d cin=%0d: expected sum=%0d cout=%0d, got sum=%0d cout=%0d", v0x5ecd1db2f150_0, v0x5ecd1db2f230_0, v0x5ecd1db2f2d0_0, &PV<v0x5ecd1db2f470_0, 0, 4>, &PV<v0x5ecd1db2f470_0, 4, 1>, v0x5ecd1db2f7c0_0, v0x5ecd1db2f3a0_0 {0 0 0};
T_1.6 ;
T_1.5 ;
    %load/vec4 v0x5ecd1db2f560_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5ecd1db2f560_0, 0, 32;
