v0x5ecd1db2eb80_0 .net *"_ivl_5", 2 0, L_0x77d2f6ca5018;  1 drivers
v0x5ecd1db2ec40_0 .net "a", 3 0, v0x5ecd1db2f150_0;  1 drivers
v0x5ecd1db2ed20_0 .net "b", 3 0, v0x5ecd1db2f230_0;  1 drivers
v0x5ecd1db2ee50_0 .net "cin", 0 0, v0x5ecd1db2f2d0_0;  1 drivers
v0x5ecd1db2ef10_0 .net "cout", 0 0, L_0x77d2f6ca5060;  alias, 1 drivers
v0x5ecd1db2efd0_0 .net "sum", 3 0, L_0x5ecd1db2fbc0;  alias, 1 drivers
L_0x5ecd1db2f940 .arith/sum 4, v0x5ecd1db2f150_0, v0x5ecd1db2f230_0;
L_0x5ecd1db2fa60 .concat [ 1 3 0 0], v0x5ecd1db2f2d0_0, L_0x77d2f6ca5018;
L_0x5ecd1db2fbc0 .arith/sum 4, L_0x5ecd1db2f940, L_0x5ecd1db2fa60;
    .scope S_0x5ecd1db14750;
T_0 ;
    %pushi/vec4 0, 0, 32;
